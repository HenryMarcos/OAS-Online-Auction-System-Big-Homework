<SplitPane dividerPositions="0.25" prefHeight="430.0" prefWidth="637.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupproject.client.HomeController">

    <VBox spacing="10.0" styleClass="sidebar-container" stylesheets="@../CSS/sidebar.css">
