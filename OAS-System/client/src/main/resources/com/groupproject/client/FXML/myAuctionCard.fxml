<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<HBox stylesheets="@../CSS/card.css" fx:id="cardroot" spacing="10.0" maxWidth="Infinity"
      styleClass="product-card"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.groupproject.client.MyAuctionCardController">

    <ImageView fx:id="image" fitHeight="120" fitWidth="120.0" preserveRatio="true"
               pickOnBounds="true" styleClass="image-container">
        <image>
            <Image url="@../Image/sample.png" />
        </image>
    </ImageView>

    <VBox spacing="6" styleClass="cardContent" maxWidth="Infinity" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="10" right="12" bottom="12" left="12" />
        </padding>

        <Label fx:id="productname" styleClass="titleCard" wrapText="true" minHeight="-Infinity" maxWidth="Infinity">
            <font>
                <Font name="Berlin Sans FB" size="16.0" />
            </font>
        </Label>

        <Label fx:id="auctionStatus" styleClass="status-label" maxWidth="Infinity" minHeight="-Infinity" wrapText="true" textFill="#888888">
            <font>
                <Font name="System Italic" size="12.0" />
            </font>
        </Label>

        <Label fx:id="currentprice" styleClass="price-label" maxWidth="Infinity" minHeight="-Infinity" wrapText="true">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <Label fx:id="timeleft" maxWidth="Infinity" minHeight="-Infinity" wrapText="true" textFill="#555555">
            <font>
                <Font name="System" size="12.0" />
            </font>
        </Label>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Action buttons — hiện/ẩn tuỳ trạng thái -->
        <HBox spacing="6" alignment="BOTTOM_RIGHT">
            <Button fx:id="startNowButton" text="▶ Bắt đầu ngay"
                    onAction="#handleStartNow"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 5;"
                    visible="false" managed="false" />
            <Button fx:id="cancelAuctionButton" text="✕ Hủy phiên"
                    onAction="#handleCancelAuction"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 5;"
                    visible="false" managed="false" />
        </HBox>
    </VBox>
</HBox>
