<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.25" prefHeight="430.0" prefWidth="637.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupproject.client.MyAuctionsController">

    <VBox spacing="10.0" styleClass="sidebar-container" stylesheets="@../CSS/sidebar.css" minWidth="180.0" maxWidth="300.0">
        <Label prefHeight="23.0" prefWidth="150.0" styleClass="sidebar-title" text="DANH MỤC SẢN PHẨM" style="-fx-font-weight: bold;"/>
        <TreeView fx:id="categoryTreeView" styleClass="modern-tree-view" VBox.vgrow="ALWAYS" />
    </VBox>

    <VBox spacing="0.0" style="-fx-background-color: #f8f9fa;">
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="10.0" right="15.0" bottom="10.0" left="15.0" />
            </padding>
            <children>
                <Label text="My Auction Listings" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <ScrollPane fx:id="scroll" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background-insets: 0;">
            <content>
                <GridPane fx:id="productgrid" hgap="12.0" vgap="12.0" style="-fx-padding: 12;">
                    </GridPane>
            </content>
        </ScrollPane>
    </VBox>
</SplitPane>