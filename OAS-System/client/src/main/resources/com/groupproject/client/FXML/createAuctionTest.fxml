<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupproject.client.CreateAuctionTestController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>

   <children>
      <Label text="Create New Auction" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
      
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: #f9f9f9; -fx-border-color: transparent;">
         <content>
            <VBox spacing="15.0">
               <padding>
                  <Insets right="15" /> </padding>

               <GridPane hgap="10" vgap="10">
                  <columnConstraints>
                     <ColumnConstraints minWidth="100" prefWidth="120" />
                     <ColumnConstraints hgrow="ALWAYS" />
                  </columnConstraints>
                  <children>
                     <Label text="Auction Title:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                     <TextField fx:id="titleField" promptText="Enter item title..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                     <Label text="Main Image:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                     <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <children>
                           <Button text="Choose File" onAction="#handleChooseMainImage" style="-fx-background-color: #e0e0e0;"/>
                           <Label fx:id="mainImageNameLabel" text="No file selected" style="-fx-text-fill: #777777;"/>
                        </children>
                     </HBox>

                     <Label text="Gallery Images:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                     <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <children>
                           <Button text="Choose Files" onAction="#handleChooseSubImages" style="-fx-background-color: #e0e0e0;"/>
                           <Label fx:id="subImagesCountLabel" text="0 images selected" style="-fx-text-fill: #777777;"/>
                        </children>
                     </HBox>

                     <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                     <TextArea fx:id="descriptionArea" prefHeight="80" promptText="Describe your item..." GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>

                     <Label text="Category:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                     <ComboBox fx:id="categoryComboBox" promptText="Select a category" prefWidth="300" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                     <Label text="Starting Price ($):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                     <TextField fx:id="startingPriceField" promptText="0.00" prefWidth="150" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                     <Label text="Timing Mode:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                     <HBox spacing="20" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="1">
                        <children>
                           <RadioButton fx:id="durationRadio" text="Set Duration" selected="true">
                              <toggleGroup>
                                 <ToggleGroup fx:id="timingToggleGroup"/>
                              </toggleGroup>
                           </RadioButton>
                           <RadioButton fx:id="dateRadio" text="Set Specific Dates" toggleGroup="$timingToggleGroup"/>
                        </children>
                     </HBox>

                     <Label fx:id="durationLabel" text="Duration Layout:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                     <HBox fx:id="durationInputBox" spacing="15" alignment="CENTER_LEFT" GridPane.rowIndex="7" GridPane.columnIndex="1">
                        <children>
                           <Label text="Days:"/>
                           <Spinner fx:id="daysSpinner" prefWidth="70" editable="true"/>
                           <Label text="Hours:"/>
                           <Spinner fx:id="hoursSpinner" prefWidth="70" editable="true"/>
                           <Label text="Mins:"/>
                           <Spinner fx:id="minsSpinner" prefWidth="70" editable="true"/>
                        </children>
                     </HBox>

                     <Label fx:id="startDateLabel" text="Start Date/Time:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                     <HBox fx:id="startDateBox" spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="8" GridPane.columnIndex="1">
                        <children>
                           <DatePicker fx:id="startDatePicker" promptText="Pick start date"/>
                           <Label text="Time:"/>
                           <ComboBox fx:id="startHourCombo" prefWidth="65"/>
                           <Label text=":"/>
                           <ComboBox fx:id="startMinCombo" prefWidth="65"/>
                        </children>
                     </HBox>

                     <Label fx:id="endDateLabel" text="End Date/Time:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                     <HBox fx:id="endDateBox" spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="9" GridPane.columnIndex="1">
                        <children>
                           <DatePicker fx:id="endDatePicker" promptText="Pick end date"/>
                           <Label text="Time:"/>
                           <ComboBox fx:id="endHourCombo" prefWidth="65"/>
                           <Label text=":"/>
                           <ComboBox fx:id="endMinCombo" prefWidth="65"/>
                        </children>
                     </HBox>

                  </children>
               </GridPane>

               <Separator />

               <Label text="Category Specifications" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
               <VBox fx:id="dynamicFieldsContainer" spacing="10" />

            </VBox>
         </content>
      </ScrollPane>
      <Separator />

      <HBox spacing="15" alignment="CENTER_RIGHT">
         <children>
            <Label fx:id="statusLabel" textFill="RED" wrapText="true" maxWidth="350" />
            <Button text="Hủy" onAction="#handleCancel" style="-fx-background-color: #e0e0e0;" />
            <Button fx:id="submitButton" text="Tạo phiên đấu giá" onAction="#handleSubmitAuction"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" />
         </children>
      </HBox>
   </children>
</VBox>




